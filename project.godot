; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Knightfall Enlightened"
config/description="An open-world medieval survival game."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.025, 0.02, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"
WorldData="*res://scripts/core/world_data.gd"
Audio="*res://scripts/core/audio.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[filesystem]

import/fbx2gltf/enabled=false
import/blender/enabled=false

[physics]

common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.web=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/use_debanding=true
global_illumination/sdfgi/probe_ray_count=2
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
mesh_lod/lod_change/threshold_pixels=1.5

[shader_globals]

wind_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
wind_strength={
"type": "float",
"value": 0.3
}
wetness={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cam_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
daylight={
"type": "float",
"value": 1.0
}
